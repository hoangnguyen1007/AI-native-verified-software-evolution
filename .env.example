# Copy to a private operator-owned file outside every repository you analyze.
# Blank endpoint and model leave the Workbench in local evidence mode.
# Use the provider's Chat Completions base URL or full endpoint.
# Loopback example: http://127.0.0.1:8081/v1
# OpenAI example: https://api.openai.com/v1
EVO_ARCH_CHAT_ENDPOINT=
EVO_ARCH_CHAT_MODEL=
EVO_ARCH_CHAT_API_KEY=
EVO_ARCH_CHAT_ALLOW_REMOTE=false
# EVO_ARCH_CHAT_REQUEST_BYTES=1048576
# EVO_ARCH_CHAT_MAX_OUTPUT_TOKENS=8192
# EVO_ARCH_CHAT_TOKEN_PARAMETER=max_completion_tokens
# EVO_ARCH_CHAT_JSON_MODE=false

# Optional separate provider for source-bearing Java repair proposals.
# Set these only when you want the existing captured-source repair workflow.
EVO_REPAIR_AI_ENDPOINT=
EVO_REPAIR_AI_MODEL=
EVO_REPAIR_AI_API_KEY=
EVO_REPAIR_AI_ALLOW_REMOTE=false
# EVO_REPAIR_AI_REQUEST_BYTES=1048576
# EVO_REPAIR_AI_MAX_OUTPUT_TOKENS=8192
# EVO_REPAIR_AI_TOKEN_PARAMETER=max_tokens
# EVO_REPAIR_AI_JSON_MODE=true
