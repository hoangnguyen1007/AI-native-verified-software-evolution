<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.evolution</groupId>
        <artifactId>software-evolution-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>backend</artifactId>
    <name>Backend</name>
    <description>
        Local asynchronous analysis orchestration and canonical query/report HTTP adapters.
    </description>

    <dependencies>
        <!-- Analyzer domain model -->
        <dependency>
            <groupId>com.evolution</groupId>
            <artifactId>analyzer</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Passive adapters are composed here; target lifecycle code never runs. -->
        <dependency><groupId>com.evolution</groupId><artifactId>analyzer-filesystem</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.evolution</groupId><artifactId>analyzer-maven</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.evolution</groupId><artifactId>analyzer-javaparser</artifactId><version>${project.version}</version></dependency>

        <!-- First-party generated-code journey; no target lifecycle/plugin execution. -->
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-protobuf</artifactId><version>1.63.0</version><scope>test</scope></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId><version>1.63.0</version><scope>test</scope></dependency>
        <dependency><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId><version>3.25.1</version><scope>test</scope></dependency>
        <dependency><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId><version>1.3.2</version><scope>test</scope></dependency>
        <!-- Testing -->
        <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><version>6.2.0</version><scope>test</scope></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>6.2.0</version><scope>test</scope></dependency>
        <dependency><groupId>com.evolution</groupId><artifactId>analyzer-execution</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Explicit platform test classes only; never included in production artifacts. -->
    <profiles>
        <profile>
            <id>native-campaign</id>
            <properties>
                <!-- Reactor order compiles this trusted fixture before backend tests.
                     Override for absolute/external platform.build.directory values. -->
                <native.fixture.classes>${maven.multiModuleProjectDirectory}/analyzer-javaparser/${platform.build.directory}/test-classes</native.fixture.classes>
            </properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><additionalClasspathElements><additionalClasspathElement>${native.fixture.classes}</additionalClasspathElement></additionalClasspathElements></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
