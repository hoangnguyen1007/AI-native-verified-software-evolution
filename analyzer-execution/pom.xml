<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.evolution</groupId><artifactId>software-evolution-platform</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>analyzer-execution</artifactId><name>Isolated native execution adapters</name>
  <dependencies>
    <dependency><groupId>com.evolution</groupId><artifactId>analyzer</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.evolution</groupId><artifactId>analyzer-filesystem</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes><exclude>**/__pycache__/**</exclude><exclude>**/*.pyc</exclude><exclude>**/*.pyo</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
        <!-- Also exclude stale copied resources from incremental builds; no clean is required. -->
        <configuration>
          <forceCreation>true</forceCreation>
          <excludes><exclude>**/__pycache__/**</exclude><exclude>**/*.pyc</exclude><exclude>**/*.pyo</exclude></excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
